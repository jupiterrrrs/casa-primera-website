+// Helper: extracts the upper bound of a pax range string (e.g. "26–30 pax" -> 30)
+// so a clicked rate package can be translated into a concrete guest count for
+// the booking form.
+export function paxUpperBound(paxStr: string): number {
+  const nums = paxStr.match(/\d+/g);
+  if (!nums || nums.length === 0) return 1;
+  return parseInt(nums[nums.length - 1], 10);
