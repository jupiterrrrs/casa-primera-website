new file mode 100644
index 0000000..b71d054
--- /dev/null
+++ b/src/app/context/ReservationSelectionContext.tsx
@@ -0,0 +1,32 @@
+import { createContext, useContext, useState, ReactNode } from "react";
+
+// Carries "the guest picked Villa X, Package Y" from the Rates section over
+// to the Booking form so it can pre-fill Selected Villa + Guests. It's a new
+// object every time Reserve is clicked (even if villa/guests happen to match
+// the previous click), so the Booking form's effect always re-fires and
+// re-applies the pre-fill.
+export type ReservationSelection = { villa: string; guests: string } | null;
+
+type ContextValue = {
+  selection: ReservationSelection;
+  setSelection: (s: ReservationSelection) => void;
+};
+
+const ReservationSelectionContext = createContext<ContextValue | undefined>(undefined);
+
+export function ReservationSelectionProvider({ children }: { children: ReactNode }) {
+  const [selection, setSelection] = useState<ReservationSelection>(null);
+  return (
+    <ReservationSelectionContext.Provider value={{ selection, setSelection }}>
+      {children}
+    </ReservationSelectionContext.Provider>
+  );
+}
+
+export function useReservationSelection() {
+  const ctx = useContext(ReservationSelectionContext);
+  if (!ctx) {
+    throw new Error("useReservationSelection must be used within a ReservationSelectionProvider");
+  }
+  return ctx;
+}
